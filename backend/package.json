{
  "name": "aurelia-backend",
  "version": "1.0.0",
  "description": "Backend API for Aurelia jewellery storefront",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeds/seedProducts.js",
    "seed:stores": "node seeds/seedStores.js",
    "seed:content": "node seeds/seedContent.js",
