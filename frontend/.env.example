# Copy to .env.local for development. Production values live in
# .env.production (or the host's environment, which takes precedence).

# Backend API (the browser and the server both call it).
NEXT_PUBLIC_API_URL=http://localhost:3232/api/v1
# Origin of the API server, used to resolve uploaded image URLs.
NEXT_PUBLIC_API_ORIGIN=http://localhost:3232

# Public storefront origin for SEO URLs. Optional in development
# (defaults to http://localhost:3000); REQUIRED in production builds.
# SITE_URL=https://ratnapankh.com

# Brand name (defaults to Ratnapankh).
# NEXT_PUBLIC_SITE_NAME=Ratnapankh

# Optional GA4 measurement ID; leave unset to disable analytics.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
