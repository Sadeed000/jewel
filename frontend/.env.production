# ─────────────────────────────────────────────────────────────────────
# Production storefront settings (no secrets — safe to commit).
#
# SITE_URL is the ONE setting for the public domain. Every canonical tag,
# Open Graph / Twitter URL, structured-data URL, robots.txt sitemap line
# and sitemap entry is built from it. Internal links stay relative.
#
# To change the domain: edit SITE_URL, then rebuild AND restart:
#     npm run build && npm start      (or your host's redeploy)
# A restart alone is not enough — pages are pre-rendered at build time.
#
# Rules (the build fails otherwise): https, bare origin (no path or
# trailing slash needed), not localhost / private IP / preview host.
# A value set in the host's environment overrides this file.
# ─────────────────────────────────────────────────────────────────────
SITE_URL=https://ratnapankh.com

# Brand name, separate from the domain. Changing the domain never needs this.
NEXT_PUBLIC_SITE_NAME=Ratnapankh

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty
# to load no analytics at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
